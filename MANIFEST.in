# Include the README
include *.md

# Include the license file
include LICENSE

# Include the data files
recursive-include data *

# Vendored pybind11 (header-only) — required to build the C++ extensions from sdist
recursive-include lib/pybind11/include *
recursive-include lib/pybind11/tools *
include lib/pybind11/CMakeLists.txt
include lib/pybind11/LICENSE

# C++ sources, headers and CMake build files for the extension modules
recursive-include src *.cpp *.h *.hpp
recursive-include src CMakeLists.txt

